
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  credentials   Credential[]
  executions    Execution[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
  @@index([identifier])
}

model Workflow {
  id             String        @id @default(cuid())
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes          Node[]
  connections    Connection[]
  executions     Execution[]

  @@index([organizationId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("workflow")
}

model Node {
  id                String       @id @default(cuid())
  name              String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  workflowId        String
  workflow          Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type              String
  position          Json
  data              Json         @default("{}")
  inputConnections  Connection[] @relation("FromNode")
  outputConnections Connection[] @relation("ToNode")

  @@map("node")
}

model Connection {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNodeId String
  fromNode   Node     @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     Node     @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  fromOutput String   @default("main")
  toInput    String   @default("main")

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@map("connection")
}

model Credential {
  id             String        @id @default(cuid())
  name           String
  type           String
  encryptedData  String
  iv             String
  authTag        String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([organizationId])
  @@map("credential")
}

model CredentialLog {
  id           String   @id @default(cuid())
  credentialId String
  userId       String
  workflowId   String?
  action       String
  timestamp    DateTime @default(now())

  @@map("credential_log")
}

model Execution {
  id             String          @id @default(cuid())
  workflowId     String
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         ExecutionStatus @default(RUNNING)
  inngestRunId   String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  result         Json?
  error          String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps          ExecutionStep[]

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status, startedAt(sort: Desc)])
  @@index([organizationId, startedAt(sort: Desc)])
  @@index([organizationId, status, startedAt(sort: Desc)])
  @@map("execution")
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ExecutionStat {
  id             String        @id @default(cuid())
  date           DateTime      @db.Date
  userId         String
  workflowId     String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  total          Int          @default(0)
  succeeded      Int           @default(0)
  failed         Int           @default(0)
  cancelled      Int           @default(0)
  durationMs     BigInt        @default(0)
  updatedAt      DateTime      @updatedAt

  @@unique([userId, workflowId, date])
  @@index([userId, date(sort: Desc)])
  @@index([organizationId, date(sort: Desc)])
  @@map("execution_stat")
}

model ExecutionStep {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeName    String
  nodeType    String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  input       Json?
  output      Json?
  error       String?

  @@index([executionId])
  @@map("execution_step")
}

model Organization {
  id             String          @id
  name           String
  slug           String
  logo           String?
  createdAt      DateTime
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  workflows      Workflow[]
  credentials    Credential[]
  executions     Execution[]
  executionStats ExecutionStat[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
